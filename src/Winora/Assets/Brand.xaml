<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- An open, folded ribbon: the rising edges of two overlapping panes form a W. -->
  <DrawingImage x:Key="WinoraMark">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="M 0,0 H 64 V 64 H 0 Z" />
        <GeometryDrawing Geometry="M 8,13 L 18,45 C 19.4,49.4 23.2,49.4 24.8,45 L 32,25 L 39.3,45 C 40.9,49.4 44.7,49.4 46.1,45 L 56,10">
          <GeometryDrawing.Pen>
            <Pen Thickness="11" StartLineCap="Round" EndLineCap="Round" LineJoin="Round">
              <Pen.Brush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.85,1">
                  <GradientStop Color="#43BEB6" Offset="0" />
                  <GradientStop Color="#147F83" Offset="0.56" />
                  <GradientStop Color="#0B626D" Offset="1" />
                </LinearGradientBrush>
              </Pen.Brush>
            </Pen>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M 32,25 L 39.3,45 C 40.9,49.4 44.7,49.4 46.1,45 L 56,10">
          <GeometryDrawing.Pen>
            <Pen Thickness="10" StartLineCap="Round" EndLineCap="Round" LineJoin="Round">
              <Pen.Brush>
                <LinearGradientBrush StartPoint="0,1" EndPoint="0.85,0">
                  <GradientStop Color="#147F83" Offset="0" />
                  <GradientStop Color="#27B4C4" Offset="0.52" />
                  <GradientStop Color="#6CDBD0" Offset="1" />
                </LinearGradientBrush>
              </Pen.Brush>
            </Pen>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M 31.1,25.6 L 24,45.4 C 22.8,48.7 20.9,48.8 19.4,46.7">
          <GeometryDrawing.Pen>
            <Pen Thickness="1.3" StartLineCap="Round" EndLineCap="Round">
              <Pen.Brush>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                  <GradientStop Color="#005DF4DF" Offset="0" />
                  <GradientStop Color="#805DF4DF" Offset="0.7" />
                  <GradientStop Color="#D0C8FFF5" Offset="1" />
                </LinearGradientBrush>
              </Pen.Brush>
            </Pen>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
</ResourceDictionary>
