<Window x:Class="Winora.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Winora" Width="1080" Height="720" MinWidth="640" MinHeight="560"
 WindowStartupLocation="CenterScreen" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}"
 FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
 Icon="Assets/Winora.ico" Loaded="OnLoaded" StateChanged="OnWindowStateChanged">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <VisualBrush x:Key="FinishWallpaper" Visual="{Binding ElementName=PreviewScene}" Stretch="Fill" />
  <DrawingImage x:Key="MiniDock">
   <DrawingImage.Drawing><DrawingGroup>
    <GeometryDrawing Brush="#348DAE" Geometry="M 0,0 H 4 V 4 H 0 Z M 5,0 H 9 V 4 H 5 Z M 0,5 H 4 V 9 H 0 Z M 5,5 H 9 V 9 H 5 Z" />
    <GeometryDrawing Brush="#CD9A3B" Geometry="M 19,1 H 23 L 25,3 H 29 V 9 H 19 Z" />
    <GeometryDrawing Brush="#2B9C98" Geometry="M 40,4.5 A 4.5,4.5 0 1 1 39.9,4.5 Z" />
   </DrawingGroup></DrawingImage.Drawing>
  </DrawingImage>
  <Style x:Key="TilingGapControl" TargetType="Slider">
   <Setter Property="Height" Value="30" /><Setter Property="Cursor" Value="Hand" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid Background="Transparent" Margin="0,3">
     <Border Height="4" Background="{DynamicResource Line}" CornerRadius="2" VerticalAlignment="Center" />
     <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="Horizontal">
      <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Height="4" VerticalAlignment="Center"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{DynamicResource Accent}" CornerRadius="2" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb Width="20" Height="20"><Thumb.Template><ControlTemplate TargetType="Thumb">
       <Border x:Name="ThumbSurface" Background="{DynamicResource ButtonSurface}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" CornerRadius="10">
        <Border.Effect><DropShadowEffect Color="{DynamicResource ToggleShadowColor}" BlurRadius="5" ShadowDepth="1" Opacity="0.12" /></Border.Effect>
       </Border>
       <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource ButtonHover}" /></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource ButtonPressed}" /><Setter TargetName="ThumbSurface" Property="BorderThickness" Value="2" /></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Height="4" VerticalAlignment="Center"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
     </Track>
     <Border x:Name="SliderFocus" BorderBrush="{DynamicResource FocusStroke}" BorderThickness="1" CornerRadius="6" Margin="-4" Visibility="Collapsed" IsHitTestVisible="False" />
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SliderFocus" Property="Visibility" Value="Visible" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid x:Name="WindowSurface" Background="{DynamicResource WindowBackground}">
  <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition /><RowDefinition Height="42" /></Grid.RowDefinitions>
  <Grid>
   <StackPanel Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
    <Image Source="{StaticResource WinoraMark}" Width="28" Height="28" Margin="0,0,10,0" />
    <TextBlock x:Name="AppNameLabel" Text="Winora" FontWeight="SemiBold" VerticalAlignment="Center" />
    <Border x:Name="DevBadge" Visibility="Collapsed" Background="{DynamicResource DevBadgeSurface}" BorderBrush="{DynamicResource DevBadgeStroke}" BorderThickness="1" CornerRadius="8" Padding="8,3" Margin="12,0,0,0" ToolTip="Dev preferences only. Windows and the installed app stay unchanged.">
     <TextBlock Text="PREVIEW ONLY" Foreground="{DynamicResource DevBadgeInk}" FontSize="10" FontWeight="SemiBold" />
    </Border>
   </StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" AutomationProperties.Name="Minimize" ToolTip="Minimize" />
    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" AutomationProperties.Name="Maximize" ToolTip="Maximize" />
    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnClose" AutomationProperties.Name="Close" ToolTip="Close" />
   </StackPanel>
  </Grid>
  <Grid x:Name="WorkspaceLayout" Grid.Row="1" SizeChanged="OnWorkspaceSizeChanged">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="164" /><ColumnDefinition /></Grid.ColumnDefinitions>
   <Border BorderBrush="{DynamicResource SidebarStroke}" BorderThickness="0,0,1,0" Background="{DynamicResource SidebarBackground}">
    <Grid Margin="10,14,10,12">
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <StackPanel>
      <RadioButton x:Name="TaskbarNavigation" GroupName="Navigation" IsChecked="True" Checked="OnSectionChanged" Style="{StaticResource NavigationItem}" AutomationProperties.Name="Taskbar" ToolTip="Taskbar">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
       <Grid Width="20" Height="20" VerticalAlignment="Center" IsHitTestVisible="False">
        <Path Data="M 3,3.5 H 17 Q 19,3.5 19,5.5 V 14.5 Q 19,16.5 17,16.5 H 3 Q 1,16.5 1,14.5 V 5.5 Q 1,3.5 3,3.5 Z M 1,12 H 19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4" />
        <Path Data="M 6,14 H 8 M 9,14 H 11 M 12,14 H 14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4" />
       </Grid>
       <TextBlock x:Name="SidebarLabel" Grid.Column="1" Text="Taskbar" Margin="12,0,0,0" VerticalAlignment="Center" />
      </Grid>
      </RadioButton>
      <RadioButton x:Name="TilingNavigation" GroupName="Navigation" Checked="OnSectionChanged" Style="{StaticResource NavigationItem}" AutomationProperties.Name="Tiling" ToolTip="Tiling" Margin="0,4,0,0">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Grid Width="20" Height="20" VerticalAlignment="Center" IsHitTestVisible="False">
         <Path Data="M 3,3 H 8 Q 9,3 9,4 V 16 Q 9,17 8,17 H 3 Q 2,17 2,16 V 4 Q 2,3 3,3 Z M 12,3 H 17 Q 18,3 18,4 V 8 Q 18,9 17,9 H 12 Q 11,9 11,8 V 4 Q 11,3 12,3 Z M 12,11 H 17 Q 18,11 18,12 V 16 Q 18,17 17,17 H 12 Q 11,17 11,16 V 12 Q 11,11 12,11 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4" />
        </Grid>
        <TextBlock x:Name="TilingSidebarLabel" Grid.Column="1" Text="Tiling" Margin="12,0,0,0" VerticalAlignment="Center" />
       </Grid>
      </RadioButton>
     </StackPanel>
     <RadioButton x:Name="SettingsNavigation" Grid.Row="2" GroupName="Navigation" Checked="OnSectionChanged" Style="{StaticResource NavigationItem}" AutomationProperties.Name="Settings" ToolTip="Settings">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
       <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="20" VerticalAlignment="Center" TextAlignment="Center" />
       <TextBlock x:Name="SettingsSidebarLabel" Grid.Column="1" Text="Settings" Margin="12,0,0,0" VerticalAlignment="Center" />
      </Grid>
     </RadioButton>
    </Grid>
   </Border>
  <ScrollViewer x:Name="TaskbarPage" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0" Focusable="False">
   <Grid x:Name="TaskbarWorkspace" Margin="28,14,28,12" MaxWidth="840">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TextBlock Text="Taskbar" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,18" AutomationProperties.HeadingLevel="Level1" />
    <Border Grid.Row="1" CornerRadius="20" Margin="0,0,0,20">
     <Border.Effect><DropShadowEffect Color="#51818D" BlurRadius="24" ShadowDepth="5" Opacity="0.12" /></Border.Effect>
     <Viewbox Stretch="Uniform" AutomationProperties.Name="Live taskbar preview" IsHitTestVisible="False">
      <Grid Width="800" Height="256">
       <Grid.Clip><RectangleGeometry Rect="0,0,800,256" RadiusX="18" RadiusY="18" /></Grid.Clip>
       <Grid x:Name="PreviewScene">
        <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#91C5DF" Offset="0" /><GradientStop Color="#D1EDE5" Offset="0.63" /><GradientStop Color="#E4F3DE" Offset="1" /></LinearGradientBrush></Grid.Background>
        <!-- Original folded-surface wallpaper: a fixed scene makes each finish comparable. -->
        <Path Data="M 320,-50 C 600,55 410,118 770,45 L 840,85 C 540,179 497,126 284,8 Z">
         <Path.Fill><LinearGradientBrush MappingMode="Absolute" StartPoint="460,-20" EndPoint="490,165"><GradientStop Color="#F1FDFF" Offset="0" /><GradientStop Color="#B4E8F2" Offset="0.12" /><GradientStop Color="#489FC0" Offset="0.7" /><GradientStop Color="#216C8F" Offset="1" /></LinearGradientBrush></Path.Fill>
        </Path>
        <Path Data="M -55,134 C 176,7 301,246 860,84 L 850,145 C 376,315 203,112 -45,188 Z">
         <Path.Fill><LinearGradientBrush MappingMode="Absolute" StartPoint="360,128" EndPoint="390,243"><GradientStop Color="#F2FFFC" Offset="0" /><GradientStop Color="#D9F5DE" Offset="0.14" /><GradientStop Color="#72C4BB" Offset="0.58" /><GradientStop Color="#338C9B" Offset="1" /></LinearGradientBrush></Path.Fill>
         <Path.Effect><DropShadowEffect Color="#397E91" BlurRadius="22" ShadowDepth="7" Direction="270" Opacity="0.14" /></Path.Effect>
        </Path>
        <Path Data="M -55,134 C 176,7 301,246 860,84" Stroke="#BEFFFFFF" StrokeThickness="1.5" />
        <Path Data="M -40,246 C 175,179 288,291 848,178 L 845,293 L -45,293 Z">
         <Path.Fill><LinearGradientBrush MappingMode="Absolute" StartPoint="400,210" EndPoint="400,285"><GradientStop Color="#AFDBDD" Offset="0" /><GradientStop Color="#E4F4E7" Offset="0.9" /></LinearGradientBrush></Path.Fill>
        </Path>
        <Path Data="M -40,246 C 175,179 288,291 848,178" Stroke="#A1FFFFFF" StrokeThickness="1" />
       </Grid>
       <Border Background="#DEFFFFFF" BorderBrush="#8FFFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0">
        <TextBlock x:Name="PreviewModeLabel" Text="Transparent" Foreground="#345D68" FontSize="12" />
       </Border>
       <Grid Height="48" VerticalAlignment="Bottom">
        <Rectangle x:Name="AcrylicBackdrop" Visibility="Collapsed">
         <Rectangle.Fill><VisualBrush Visual="{Binding ElementName=PreviewScene}" Viewbox="0,0.8125,1,0.1875" ViewboxUnits="RelativeToBoundingBox" Stretch="Fill" /></Rectangle.Fill>
         <Rectangle.Effect><BlurEffect Radius="14" /></Rectangle.Effect>
        </Rectangle>
        <Border x:Name="PreviewBar" Background="Transparent" BorderBrush="#8CFFFFFF" BorderThickness="0,1,0,0">
         <Grid Margin="18,0">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
           <Path Data="M 0,0 H 8 V 8 H 0 Z M 10,0 H 18 V 8 H 10 Z M 0,10 H 8 V 18 H 0 Z M 10,10 H 18 V 18 H 10 Z" Width="18" Height="18" Fill="#2989B4" Margin="0,0,22,0" VerticalAlignment="Center" />
           <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#35596B" Margin="0,0,22,0" VerticalAlignment="Center" />
           <Grid Width="22" Height="20" Margin="0,0,22,0" VerticalAlignment="Center"><Path Fill="#E6B753" Data="M 0,3 H 8 L 10,5 H 22 V 19 H 0 Z" /><Path Fill="#F7CF78" Data="M 0,8 H 22 L 20,19 H 0 Z" /></Grid>
           <Grid Width="21" Height="21" VerticalAlignment="Center"><Ellipse><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#278BCC" Offset="0" /><GradientStop Color="#33C7A5" Offset="1" /></LinearGradientBrush></Ellipse.Fill></Ellipse><Path Data="M 5,13 Q 7,4 15,8 Q 11,7 10,12 Q 13,15 18,13" Stroke="#D8FFF4" StrokeThickness="2" /></Grid>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
           <TextBlock x:Name="TrayPreviewOverflow" Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#365C67" VerticalAlignment="Center" Margin="0,0,12,0" />
           <StackPanel x:Name="TrayPreviewApps" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,12,0"><Ellipse Width="9" Height="9" Fill="#4F8CB7" Margin="0,0,7,0" /><Path Data="M 0,0 H 9 V 9 H 0 Z" Fill="#5B9982" Margin="0,0,7,0" /><Path Data="M 0,9 L 5,0 L 10,9 Z" Fill="#805D9C" /></StackPanel>
           <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" Foreground="#365C67" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center" />
           <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" Foreground="#365C67" FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center" />
           <TextBlock Text="10:24" Foreground="#365C67" FontSize="10" VerticalAlignment="Center" />
          </StackPanel>
         </Grid>
        </Border>
       </Grid>
       <Border BorderBrush="#80FFFFFF" BorderThickness="1" CornerRadius="18" IsHitTestVisible="False" />
      </Grid>
     </Viewbox>
    </Border>
    <UniformGrid Grid.Row="2" Columns="3" KeyboardNavigation.DirectionalNavigation="Contained">
     <RadioButton x:Name="DefaultMode" GroupName="Mode" Tag="Default" Style="{StaticResource ModeOption}" Margin="0,0,6,0" Checked="OnModeChanged" AutomationProperties.Name="Default taskbar finish">
      <StackPanel>
       <Border Height="48" CornerRadius="8" Background="{StaticResource FinishWallpaper}" Margin="0,0,0,12">
        <Border Background="#F0E5EDF1" Height="19" CornerRadius="0,0,7,7" VerticalAlignment="Bottom"><Image Source="{StaticResource MiniDock}" Height="9" Width="49" /></Border>
       </Border><TextBlock Text="Default" FontWeight="SemiBold" />
      </StackPanel>
     </RadioButton>
     <RadioButton x:Name="TransparentMode" GroupName="Mode" Tag="Transparent" Style="{StaticResource ModeOption}" Margin="6,0,6,0" Checked="OnModeChanged" AutomationProperties.Name="Transparent taskbar finish">
      <StackPanel>
       <Border Height="48" CornerRadius="8" Background="{StaticResource FinishWallpaper}" Margin="0,0,0,12"><Image Source="{StaticResource MiniDock}" Height="9" Width="49" VerticalAlignment="Bottom" Margin="0,0,0,5" /></Border>
       <TextBlock Text="Transparent" FontWeight="SemiBold" />
      </StackPanel>
     </RadioButton>
     <RadioButton x:Name="AcrylicMode" GroupName="Mode" Tag="Acrylic" Style="{StaticResource ModeOption}" Margin="6,0,0,0" Checked="OnModeChanged" AutomationProperties.Name="Acrylic taskbar finish">
      <StackPanel>
       <Grid Height="48" Margin="0,0,0,12">
        <Border x:Name="AcrylicMiniScene" Background="{StaticResource FinishWallpaper}" CornerRadius="8" />
        <Rectangle Height="19" VerticalAlignment="Bottom"><Rectangle.Fill><VisualBrush Visual="{Binding ElementName=AcrylicMiniScene}" Viewbox="0,0.6,1,0.4" ViewboxUnits="RelativeToBoundingBox" /></Rectangle.Fill><Rectangle.Effect><BlurEffect Radius="5" /></Rectangle.Effect></Rectangle>
        <Border Background="#70ECF8F7" Height="19" CornerRadius="0,0,7,7" VerticalAlignment="Bottom"><Image Source="{StaticResource MiniDock}" Height="9" Width="49" /></Border>
       </Grid><TextBlock Text="Acrylic" FontWeight="SemiBold" />
      </StackPanel>
     </RadioButton>
    </UniformGrid>
    <Grid Grid.Row="3">
     <Grid.Style><Style TargetType="Grid">
      <Setter Property="Margin" Value="0,8,0,4" /><Setter Property="MinHeight" Value="22" />
      <Style.Triggers><MultiDataTrigger>
       <MultiDataTrigger.Conditions><Condition Binding="{Binding Text, ElementName=StatusLabel}" Value="" /><Condition Binding="{Binding Visibility, ElementName=ActivityLabel}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=RetryButton}" Value="Collapsed" /></MultiDataTrigger.Conditions>
       <Setter Property="Margin" Value="0,10,0,0" /><Setter Property="MinHeight" Value="0" />
      </MultiDataTrigger></Style.Triggers>
     </Style></Grid.Style>
     <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="StatusLabel" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
       <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}" /><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger><Trigger Property="Tag" Value="Error"><Setter Property="Foreground" Value="{DynamicResource ErrorInk}" /></Trigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
      <TextBlock x:Name="ActivityLabel" Foreground="{DynamicResource Accent}" FontSize="12" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
     </StackPanel>
     <Button x:Name="RetryButton" Grid.Column="1" Content="Retry" Visibility="Collapsed" Style="{StaticResource ChromeAction}" Click="OnRetry" Margin="12,0,0,0" AutomationProperties.Name="Retry taskbar change" />
    </Grid>
    <StackPanel Grid.Row="4">
     <CheckBox x:Name="TrayIconsCheckBox" Style="{StaticResource SettingsCheckBox}" Checked="OnTrayPreferenceChanged" Unchecked="OnTrayPreferenceChanged" AutomationProperties.Name="Always show app tray icons" AutomationProperties.HelpText="Keeps registered app icons visible, including new apps, while Winora is closed. Windows controls system and temporary icons." ToolTip="Includes new apps. Continues while Winora is closed. Windows controls system and temporary icons.">
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" Width="30" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" /><TextBlock Text="Always show app tray icons" VerticalAlignment="Center" /></StackPanel>
     </CheckBox>
     <TextBlock x:Name="TrayStatusLabel" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="30,2,0,4" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
   </Grid>
  </ScrollViewer>
   <ScrollViewer x:Name="TilingPage" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel x:Name="TilingWorkspace" Margin="28,14,28,12" MaxWidth="840">
     <TextBlock Text="Tiling" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,18" AutomationProperties.HeadingLevel="Level1" />
     <Border CornerRadius="20" Margin="0,0,0,12">
      <Border.Effect><DropShadowEffect Color="#51818D" BlurRadius="24" ShadowDepth="5" Opacity="0.12" /></Border.Effect>
      <Viewbox Stretch="Uniform" IsHitTestVisible="False" AutomationProperties.Name="Tiled window layout preview">
       <Grid x:Name="TilingPreviewScene" Width="800" Height="256">
        <Grid.Clip><RectangleGeometry Rect="0,0,800,256" RadiusX="18" RadiusY="18" /></Grid.Clip>
        <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#B2D7E3" Offset="0" /><GradientStop Color="#DBEDE4" Offset="1" /></LinearGradientBrush></Grid.Background>
        <Grid Margin="18,18,18,30">
         <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
         <Border x:Name="TilingPreviewPrimary" Background="{DynamicResource ButtonSurface}" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="8" Margin="0,0,4,0">
          <Grid><Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition /></Grid.RowDefinitions>
           <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"><TextBlock Text="Editor" Foreground="{DynamicResource Ink}" FontSize="12" Margin="12,0" VerticalAlignment="Center" /></Border>
           <StackPanel Grid.Row="1" Margin="14,16" Opacity="0.5"><Border Height="5" Width="132" Background="{DynamicResource Line}" CornerRadius="2" HorizontalAlignment="Left" /><Border Height="5" Width="204" Background="{DynamicResource Line}" CornerRadius="2" HorizontalAlignment="Left" Margin="0,9,0,0" /><Border Height="5" Width="174" Background="{DynamicResource Line}" CornerRadius="2" HorizontalAlignment="Left" Margin="0,9,0,0" /></StackPanel>
          </Grid>
         </Border>
         <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
          <Border x:Name="TilingPreviewSecondary" Background="{DynamicResource ButtonSurface}" BorderBrush="{DynamicResource ModeStroke}" BorderThickness="1" CornerRadius="8" Margin="4,0,0,4">
           <Grid><Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition /></Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"><TextBlock Text="Browser" Foreground="{DynamicResource Muted}" FontSize="12" Margin="12,0" VerticalAlignment="Center" /></Border>
            <Border Grid.Row="1" Height="18" Background="{DynamicResource ModeSelected}" CornerRadius="4" Margin="14,10" VerticalAlignment="Top" />
           </Grid>
          </Border>
          <Border x:Name="TilingPreviewTertiary" Grid.Row="1" Background="{DynamicResource ButtonSurface}" BorderBrush="{DynamicResource ModeStroke}" BorderThickness="1" CornerRadius="8" Margin="4,4,0,0">
           <Grid><Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition /></Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"><TextBlock Text="Terminal" Foreground="{DynamicResource Muted}" FontSize="12" Margin="12,0" VerticalAlignment="Center" /></Border>
            <TextBlock Grid.Row="1" Text="›_" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource Muted}" FontSize="14" Margin="14,8" />
           </Grid>
          </Border>
         </Grid>
        </Grid>
        <Border Height="18" Background="#70FFFFFF" BorderBrush="#70FFFFFF" BorderThickness="0,1,0,0" VerticalAlignment="Bottom">
         <Image Source="{StaticResource MiniDock}" Height="7" Width="38" VerticalAlignment="Center" />
        </Border>
        <Border BorderBrush="#80FFFFFF" BorderThickness="1" CornerRadius="18" IsHitTestVisible="False" />
       </Grid>
      </Viewbox>
     </Border>
     <CheckBox x:Name="TilingEnabledCheckBox" Style="{StaticResource SettingsCheckBox}" Checked="OnTilingEnabledChanged" Unchecked="OnTilingEnabledChanged" AutomationProperties.Name="Automatically tile windows" AutomationProperties.HelpText="Arranges application windows automatically. Dialogs and excluded windows remain floating.">
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" Width="30" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" /><TextBlock Text="Automatically tile windows" VerticalAlignment="Center" /></StackPanel>
     </CheckBox>
     <Button x:Name="TiledAppsButton" Content="Apps…" Click="OnManageTiledApps" Style="{StaticResource ChromeAction}" HorizontalAlignment="Left" Margin="30,-4,0,8" AutomationProperties.Name="Manage custom-window apps" AutomationProperties.HelpText="Choose apps with custom window frames to keep them tiled. Apps selected as games stay outside tiling." />
     <Popup x:Name="TiledAppsPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=TiledAppsButton}" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="0" VerticalOffset="6" Focusable="False">
      <Border Width="300" Background="{DynamicResource ButtonSurface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="10" TextElement.Foreground="{DynamicResource Ink}" TextElement.FontFamily="Segoe UI Variable, Segoe UI" TextElement.FontSize="14">
       <Border.Effect><DropShadowEffect Color="{DynamicResource ModeShadowColor}" BlurRadius="16" ShadowDepth="3" Opacity="0.14" /></Border.Effect>
       <StackPanel>
        <TextBlock Text="Custom-window apps" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock Text="Keep selected apps tiled." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" />
        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0,10,0,0">
         <StackPanel x:Name="TiledAppsList" />
        </ScrollViewer>
        <Button Content="Add app…" Click="OnAddTiledApp" HorizontalAlignment="Left" Margin="0,10,0,0" AutomationProperties.Name="Add an app to keep tiled" />
       </StackPanel>
      </Border>
     </Popup>
     <Border Height="1" Background="{DynamicResource Line}" Margin="0,2,0,14" />
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock Text="Window gaps" VerticalAlignment="Center" />
      <TextBlock x:Name="TilingGapValue" Grid.Column="1" Text="8 px" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" />
      <Slider x:Name="TilingGapSlider" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource TilingGapControl}" Minimum="0" Maximum="32" Value="8" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="4" ValueChanged="OnTilingGapChanged" Margin="0,8,0,8" AutomationProperties.Name="Window gaps" AutomationProperties.HelpText="Gap between tiled windows, in pixels." />
     </Grid>
     <CheckBox x:Name="FullscreenRoutingCheckBox" Style="{StaticResource SettingsCheckBox}" Checked="OnFullscreenRoutingChanged" Unchecked="OnFullscreenRoutingChanged" AutomationProperties.Name="Move tiles away from fullscreen games" AutomationProperties.HelpText="Detects exclusive Direct3D fullscreen games automatically. Add games to detect their borderless fullscreen windows. Moves tiles to other available monitors and restores them when fullscreen ends." ToolTip="Moves tiles to other available monitors while a game is fullscreen, then restores them. Add games for borderless fullscreen.">
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" Width="30" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" /><TextBlock Text="Move tiles away from fullscreen games" VerticalAlignment="Center" /></StackPanel>
     </CheckBox>
     <Button x:Name="FullscreenGamesButton" Content="Games…" Click="OnManageFullscreenGames" Style="{StaticResource ChromeAction}" HorizontalAlignment="Left" Margin="30,-4,0,8" AutomationProperties.Name="Manage fullscreen games" AutomationProperties.HelpText="Selected games stay outside tiling, including in windowed mode." />
     <Popup x:Name="FullscreenGamesPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=FullscreenGamesButton}" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="0" VerticalOffset="6" Focusable="False">
      <Border Width="300" Background="{DynamicResource ButtonSurface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="10" TextElement.Foreground="{DynamicResource Ink}" TextElement.FontFamily="Segoe UI Variable, Segoe UI" TextElement.FontSize="14">
       <Border.Effect><DropShadowEffect Color="{DynamicResource ModeShadowColor}" BlurRadius="16" ShadowDepth="3" Opacity="0.14" /></Border.Effect>
       <StackPanel>
        <TextBlock Text="Games" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock Text="Add games that use borderless fullscreen. Selected games stay outside tiling, including in windowed mode." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" />
        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0,10,0,0">
         <StackPanel x:Name="FullscreenGamesList" />
        </ScrollViewer>
        <Button Content="Add game…" Click="OnAddFullscreenGame" HorizontalAlignment="Left" Margin="0,10,0,0" AutomationProperties.Name="Add a fullscreen game" />
       </StackPanel>
      </Border>
     </Popup>
     <Grid Margin="0,4,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
       <Button x:Name="TilingPauseButton" Content="Pause" Click="OnTilingPause" AutomationProperties.Name="Pause automatic tiling" Margin="0,0,8,0" />
       <Button x:Name="TilingRetileButton" Content="Rearrange" Click="OnTilingRetile" AutomationProperties.Name="Rearrange tiled windows" />
      </StackPanel>
      <Button x:Name="RetryTilingButton" Grid.Column="1" Content="Retry" Visibility="Collapsed" Style="{StaticResource ChromeAction}" Click="OnTilingRetry" AutomationProperties.Name="Retry tiling change" />
     </Grid>
     <TextBlock x:Name="TilingStatusLabel" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite">
      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}" /><Setter Property="Visibility" Value="Visible" /><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger><Trigger Property="Tag" Value="Error"><Setter Property="Foreground" Value="{DynamicResource ErrorInk}" /></Trigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
     <Border Height="1" Background="{DynamicResource Line}" Margin="0,18,0,14" />
     <Grid TextElement.Foreground="{DynamicResource Muted}">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
      <TextBlock Text="Alt + arrows" FontSize="12" Margin="0,0,24,7" /><TextBlock Grid.Column="1" Text="Focus" FontSize="12" />
      <TextBlock Grid.Row="1" Text="Alt + Shift + arrows" FontSize="12" Margin="0,0,24,7" /><TextBlock Grid.Row="1" Grid.Column="1" Text="Move" FontSize="12" />
      <TextBlock Grid.Row="2" Text="Alt + Shift + Space" FontSize="12" Margin="0,0,24,7" /><TextBlock Grid.Row="2" Grid.Column="1" Text="Float" FontSize="12" />
      <TextBlock Grid.Row="3" Text="Alt + Ctrl + arrows" FontSize="12" Margin="0,0,24,7" /><TextBlock Grid.Row="3" Grid.Column="1" Text="Resize" FontSize="12" />
      <TextBlock Grid.Row="4" Text="Alt + V" FontSize="12" Margin="0,0,24,7" /><TextBlock Grid.Row="4" Grid.Column="1" Text="Change split direction" FontSize="12" />
      <TextBlock Grid.Row="5" Text="Alt + Shift + P" FontSize="12" Margin="0,0,24,7" /><TextBlock Grid.Row="5" Grid.Column="1" Text="Pause / resume" FontSize="12" />
      <TextBlock Grid.Row="6" Text="Alt + Shift + E" FontSize="12" Margin="0,0,24,0" /><TextBlock Grid.Row="6" Grid.Column="1" Text="Stop (while running)" FontSize="12" />
     </Grid>
    </StackPanel>
   </ScrollViewer>
   <ScrollViewer x:Name="SettingsPage" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel x:Name="SettingsWorkspace" Margin="28,14,28,12" MaxWidth="840">
     <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,18" AutomationProperties.HeadingLevel="Level1" />
     <CheckBox x:Name="StartupCheckBox" Style="{StaticResource SettingsCheckBox}" Checked="OnStartupChanged" Unchecked="OnStartupChanged" AutomationProperties.Name="Start Winora with Windows" AutomationProperties.HelpText="Restores enabled features at sign-in without opening this window. Turning it off leaves current features running." ToolTip="Restores enabled features at sign-in without opening this window.">
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" Width="30" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" /><TextBlock Text="Start Winora with Windows" VerticalAlignment="Center" /></StackPanel>
     </CheckBox>
     <TextBlock x:Name="StartupStatusLabel" Foreground="{DynamicResource ErrorInk}" FontSize="12" TextWrapping="Wrap" Margin="30,2,0,4" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
     <Border Height="1" Background="{DynamicResource Line}" Margin="0,2" />
     <CheckBox x:Name="DarkModeCheckBox" Style="{StaticResource SettingsCheckBox}" Checked="OnDarkModeChanged" Unchecked="OnDarkModeChanged" AutomationProperties.Name="Dark mode">
      <StackPanel Orientation="Horizontal">
       <Path Data="M 14,2 A 8,8 0 1 0 18,14 A 7,7 0 0 1 14,2 Z" Stroke="{DynamicResource Muted}" StrokeThickness="1.4" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center" />
       <TextBlock Text="Dark mode" VerticalAlignment="Center" />
      </StackPanel>
     </CheckBox>
     <TextBlock x:Name="ThemeStatusLabel" Foreground="{DynamicResource ErrorInk}" FontSize="12" TextWrapping="Wrap" Margin="30,6,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <Grid Grid.Row="2" Margin="24,0,24,6" VerticalAlignment="Center">
   <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock x:Name="VersionLabel" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
    <Button x:Name="UpdateButton" Content="Check for updates" Style="{StaticResource ChromeAction}" Click="OnCheckUpdates" />
    <TextBlock x:Name="UpdateLabel" Foreground="{DynamicResource Muted}" FontSize="12" MaxWidth="180" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
   </StackPanel>
   <TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"><Hyperlink x:Name="EngineLink" NavigateUri="https://github.com/TranslucentTB/TranslucentTB" RequestNavigate="OnNavigate" Foreground="{DynamicResource Muted}" TextDecorations="None">TranslucentTB</Hyperlink></TextBlock>
  </Grid>
 </Grid>
</Window>
