<Window x:Class="Winora.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Winora" Width="960" Height="800" MinWidth="850" MinHeight="690"
 WindowStartupLocation="CenterScreen" Background="#121722" Foreground="{StaticResource Ink}" FontFamily="Segoe UI Variable, Segoe UI"
 Loaded="OnLoaded">
 <Grid Background="#121722">
  <Grid.ColumnDefinitions><ColumnDefinition Width="205" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
  <Border Background="#171D29" BorderBrush="#293142" BorderThickness="0,0,1,0">
   <Grid Margin="22,32,22,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
      <Border Width="30" Height="30" CornerRadius="9" Background="#B6C7FF" Margin="0,0,10,0">
       <TextBlock Text="W" Foreground="#171D29" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <TextBlock Text="winora" FontSize="25" FontWeight="SemiBold" />
     </StackPanel>
     <TextBlock Text="Make Windows yours." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,38" />
     <Border Background="#29334C" CornerRadius="8" Padding="13,12">
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" Margin="0,0,10,0" /><TextBlock Text="Appearance" FontWeight="SemiBold" /></StackPanel>
     </Border>
    </StackPanel>
    <StackPanel Grid.Row="2">
     <TextBlock Text="WINDOWS 11 · PREVIEW" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,7" />
     <TextBlock x:Name="VersionLabel" Foreground="{StaticResource Muted}" FontSize="12" />
    </StackPanel>
   </Grid>
  </Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
   <StackPanel Margin="36,30,36,26">
    <TextBlock Text="YOUR DESKTOP, YOUR WAY" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8" />
    <TextBlock Text="A little more you." FontSize="30" FontWeight="SemiBold" Margin="0,0,0,6" />
    <TextBlock Text="Start with a taskbar that fits your desktop." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,0,0,23" />
    <Border Height="155" CornerRadius="14" ClipToBounds="True" Margin="0,0,0,23">
     <Grid>
      <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#283A70" Offset="0" /><GradientStop Color="#605892" Offset="0.5" /><GradientStop Color="#C895A2" Offset="1" /></LinearGradientBrush></Grid.Background>
      <Ellipse Width="390" Height="240" Fill="#4676A8" Opacity="0.45" HorizontalAlignment="Left" Margin="-50,55,0,-80" />
      <Ellipse Width="320" Height="260" Fill="#EAB6BA" Opacity="0.2" HorizontalAlignment="Right" Margin="0,-120,-40,0" />
      <TextBlock Text="A clearer view." FontSize="19" FontWeight="SemiBold" Margin="22,21,0,0" />
      <TextBlock Text="Illustrative preview" FontSize="10" Opacity="0.7" HorizontalAlignment="Right" Margin="0,17,17,0" />
      <Border x:Name="PreviewBar" Height="39" Background="#EE202737" VerticalAlignment="Bottom">
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="&#xE782;" FontFamily="Segoe Fluent Icons" FontSize="19" Foreground="#A6CAFF" Margin="0,0,19,0" />
        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="17" Margin="0,0,19,0" />
        <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="19" Foreground="#F6D790" Margin="0,0,19,0" />
        <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons" FontSize="19" Foreground="#A4D8E9" />
       </StackPanel>
      </Border>
     </Grid>
    </Border>
    <TextBlock Text="Taskbar translucency" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,5" />
    <TextBlock Text="Choose a finish. Apply it whenever you’re ready." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,14" />
    <UniformGrid Columns="3" Margin="0,0,0,16">
     <RadioButton x:Name="DefaultMode" GroupName="Mode" Tag="Default" Style="{StaticResource ModeCard}" Margin="0,0,7,0" Checked="OnModeChanged" AutomationProperties.Name="Default taskbar">
      <StackPanel><TextBlock Text="&#xE737;" FontFamily="Segoe Fluent Icons" FontSize="21" Foreground="{StaticResource Accent}" Margin="0,0,0,13" /><TextBlock Text="Default" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="Windows original" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,0" /></StackPanel>
     </RadioButton>
     <RadioButton x:Name="TransparentMode" GroupName="Mode" Tag="Transparent" Style="{StaticResource ModeCard}" Margin="3,0,3,0" Checked="OnModeChanged" AutomationProperties.Name="Transparent taskbar">
      <StackPanel><TextBlock Text="&#xE6A7;" FontFamily="Segoe Fluent Icons" FontSize="21" Foreground="{StaticResource Accent}" Margin="0,0,0,13" /><TextBlock Text="Transparent" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="Let your wallpaper shine" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,0" /></StackPanel>
     </RadioButton>
     <RadioButton x:Name="AcrylicMode" GroupName="Mode" Tag="Acrylic" Style="{StaticResource ModeCard}" Margin="7,0,0,0" Checked="OnModeChanged" AutomationProperties.Name="Acrylic taskbar">
      <StackPanel><TextBlock Text="&#xE91B;" FontFamily="Segoe Fluent Icons" FontSize="21" Foreground="{StaticResource Accent}" Margin="0,0,0,13" /><TextBlock Text="Acrylic" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="Soft, frosted glass" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,0" /></StackPanel>
     </RadioButton>
    </UniformGrid>
    <CheckBox x:Name="StartupCheckBox" Content="Start taskbar effects with Windows" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,14" />
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <TextBlock Text="Effects stay active when you close this window." Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
     <Button x:Name="ApplyButton" Grid.Column="1" Content="Apply appearance" Background="#B6C7FF" Foreground="#17213A" BorderBrush="#B6C7FF" Click="OnApply" />
    </Grid>
    <TextBlock x:Name="StatusLabel" Text="Ready." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" MinHeight="33" AutomationProperties.LiveSetting="Polite" />
    <TextBlock FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,5">
     Taskbar effects powered by <Hyperlink NavigateUri="https://github.com/TranslucentTB/TranslucentTB" RequestNavigate="OnNavigate" Foreground="{StaticResource Accent}">TranslucentTB</Hyperlink> · first use downloads 1.7 MB.
    </TextBlock>
    <Border Background="#1B2130" BorderBrush="#303849" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,8,0,0">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="App updates" FontSize="14" FontWeight="SemiBold" /><TextBlock x:Name="UpdateLabel" Text="Checks automatically when you open Winora." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,12,0" TextWrapping="Wrap" /></StackPanel>
      <Button x:Name="UpdateButton" Grid.Column="1" Content="Check for updates" Click="OnCheckUpdates" VerticalAlignment="Center" />
     </Grid>
    </Border>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
