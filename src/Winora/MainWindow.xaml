<Window x:Class="Winora.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Winora" Width="960" Height="820" MinWidth="680" MinHeight="650"
 WindowStartupLocation="CenterScreen" Background="#191919" Foreground="{StaticResource Ink}"
 FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Icon="Assets/Winora.ico" Loaded="OnLoaded" StateChanged="OnWindowStateChanged">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
 </shell:WindowChrome.WindowChrome>
 <Grid x:Name="WindowSurface" Background="#191919">
  <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <Grid>
   <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
    <Image Source="{StaticResource WinoraMark}" Width="24" Height="24" Margin="0,0,10,0" />
    <TextBlock x:Name="AppNameLabel" Text="Winora" FontWeight="SemiBold" VerticalAlignment="Center" />
    <Border x:Name="DevBadge" Visibility="Collapsed" Background="#514324" CornerRadius="4" Padding="8,3" Margin="12,0,0,0"><TextBlock Text="DEV PREVIEW · Windows changes disabled" Foreground="#F2D28A" FontSize="11" /></Border>
   </StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" AutomationProperties.Name="Minimize" ToolTip="Minimize" />
    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" AutomationProperties.Name="Maximize" ToolTip="Maximize" />
    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnClose" AutomationProperties.Name="Close" ToolTip="Close" />
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="184" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <Grid Margin="10,14,10,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border Background="#2C2C2C" CornerRadius="4" Height="38" AutomationProperties.Name="Taskbar, selected">
     <Grid><Border Width="3" Height="16" Background="{StaticResource Accent}" CornerRadius="2" HorizontalAlignment="Left" />
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
       <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center" />
       <TextBlock Text="Taskbar" FontWeight="SemiBold" />
      </StackPanel>
     </Grid>
    </Border>
    <StackPanel Grid.Row="2" Margin="12,0,8,0">
     <TextBlock x:Name="VersionLabel" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4" />
     <Button x:Name="UpdateButton" Content="Check for updates" Style="{StaticResource ChromeAction}" Click="OnCheckUpdates" HorizontalAlignment="Left" />
     <TextBlock x:Name="UpdateLabel" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
   </Grid>
   <Border Grid.Column="1" Background="#202020" CornerRadius="8,0,0,0" BorderBrush="#303030" BorderThickness="1,1,0,0">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="28,16,28,16">
      <TextBlock Text="PERSONALISATION" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,0,0,4" /><TextBlock Text="Taskbar" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,8" /><TextBlock Text="A little detail. A desktop that feels like yours." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,0,0,16" />
      <Grid Margin="0,0,0,8"><TextBlock Text="APPEARANCE PREVIEW" Foreground="{StaticResource Muted}" FontSize="12" />
       <TextBlock x:Name="PreviewModeLabel" Text="Default" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="12" />
      </Grid>
      <Border CornerRadius="8" BorderBrush="{StaticResource CardStroke}" BorderThickness="1" Margin="0,0,0,16">
       <Grid Height="132" ClipToBounds="True" AutomationProperties.Name="Taskbar finish preview">
        <Grid x:Name="PreviewScene">
         <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#172B4B" Offset="0" /><GradientStop Color="#51679B" Offset="0.55" /><GradientStop Color="#B09AAE" Offset="1" /></LinearGradientBrush></Grid.Background>
         <Path Data="M 0,150 C 90,10 180,190 290,60 S 440,20 600,140 L 600,240 L 0,240 Z" Fill="#557EB6" Opacity="0.45" Stretch="Fill" /><Path Data="M 0,200 C 130,110 250,250 380,110 S 520,70 650,180 L 650,260 L 0,260 Z" Fill="#A8BDD9" Opacity="0.25" Stretch="Fill" />
         <Border Width="148" Height="80" Background="#E92C3339" BorderBrush="#667480" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,18,0,0">
          <Grid><Grid.RowDefinitions><RowDefinition Height="18" /><RowDefinition /></Grid.RowDefinitions>
           <Border BorderBrush="#44505A" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,7,0" VerticalAlignment="Center"><Rectangle Width="6" Height="1" Fill="#A7B4BF" Margin="0,0,7,0" /><Rectangle Width="5" Height="5" Stroke="#A7B4BF" /></StackPanel></Border>
           <StackPanel Grid.Row="1" Margin="12,12"><Rectangle Height="4" Width="74" Fill="#8598A6" HorizontalAlignment="Left" Margin="0,0,0,7" /><Rectangle Height="4" Width="106" Fill="#505F69" HorizontalAlignment="Left" /></StackPanel>
          </Grid>
         </Border>
        </Grid>
        <Grid Height="38" VerticalAlignment="Bottom">
         <Rectangle x:Name="AcrylicBackdrop" Visibility="Collapsed"><Rectangle.Fill><VisualBrush Visual="{Binding ElementName=PreviewScene}" Viewbox="0,0.7121,1,0.2879" ViewboxUnits="RelativeToBoundingBox" Stretch="Fill" /></Rectangle.Fill><Rectangle.Effect><BlurEffect Radius="14" /></Rectangle.Effect></Rectangle>
         <Border x:Name="PreviewBar" Background="#EE202020" BorderBrush="#30FFFFFF" BorderThickness="0,1,0,0">
          <Grid Margin="12,0">
           <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Path Data="M 0,0 H 7 V 7 H 0 Z M 9,0 H 16 V 7 H 9 Z M 0,9 H 7 V 16 H 0 Z M 9,9 H 16 V 16 H 9 Z" Width="16" Height="16" Fill="#A6CEFF" Margin="0,0,16,0" VerticalAlignment="Center" />
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,16,0" />
            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#ECD394" Margin="0,0,16,0" />
            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#A4D8E9" />
           </StackPanel>
           <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,8,0" /><TextBlock Text="10:24" FontSize="10" /></StackPanel>
          </Grid>
         </Border>
        </Grid>
       </Grid>
      </Border>
      <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
       <StackPanel>
        <TextBlock Text="Taskbar finish" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="Choose a look, then apply it to your desktop." Foreground="{StaticResource Muted}" Margin="0,4,0,16" />
        <UniformGrid Columns="3" Margin="0,0,0,20">
         <RadioButton x:Name="DefaultMode" GroupName="Mode" Tag="Default" Style="{StaticResource ModeOption}" Margin="0,0,4,0" Checked="OnModeChanged" AutomationProperties.Name="Default taskbar, Windows original finish"><StackPanel><TextBlock Text="Default" FontWeight="SemiBold" /><TextBlock Text="Windows original" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0" /></StackPanel></RadioButton>
         <RadioButton x:Name="TransparentMode" GroupName="Mode" Tag="Transparent" Style="{StaticResource ModeOption}" Margin="4,0,4,0" Checked="OnModeChanged" AutomationProperties.Name="Transparent taskbar, clear wallpaper"><StackPanel><TextBlock Text="Transparent" FontWeight="SemiBold" /><TextBlock Text="Clear wallpaper" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0" /></StackPanel></RadioButton>
         <RadioButton x:Name="AcrylicMode" GroupName="Mode" Tag="Acrylic" Style="{StaticResource ModeOption}" Margin="4,0,0,0" Checked="OnModeChanged" AutomationProperties.Name="Acrylic taskbar, softly blurred"><StackPanel><TextBlock Text="Acrylic" FontWeight="SemiBold" /><TextBlock Text="Softly blurred" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0" /></StackPanel></RadioButton>
        </UniformGrid>
        <CheckBox x:Name="StartupCheckBox" Content="Start taskbar effects with Windows" Style="{StaticResource SettingsCheckBox}" />
        <TextBlock Text="Your selected finish will be restored when you sign in." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="30,6,0,20" />
        <Border BorderBrush="{StaticResource CardStroke}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusLabel" Text="Ready to personalise your taskbar." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" AutomationProperties.LiveSetting="Polite" />
          <Button x:Name="ApplyButton" Grid.Column="1" Content="Apply changes" MinWidth="120" Background="{StaticResource Accent}" Foreground="#12232D" BorderBrush="{StaticResource Accent}" Click="OnApply" />
         </Grid>
        </Border>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource SettingsCard}">
       <StackPanel>
        <Grid Margin="0,0,0,16"><TextBlock Text="System tray" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Saves automatically" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Muted}" /></Grid>
        <CheckBox x:Name="TrayIconsCheckBox" Content="Always show app tray icons" Style="{StaticResource SettingsCheckBox}" Checked="OnTrayPreferenceChanged" Unchecked="OnTrayPreferenceChanged" ToolTip="Runs at sign-in and while Winora is closed. Applies to registered app icons; Windows controls system and temporary icons." />
        <TextBlock Text="Keep app icons visible, even when Winora is closed." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="30,6,0,0" />
        <TextBlock x:Name="TrayStatusLabel" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="30,8,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
       </StackPanel>
      </Border>
      <TextBlock FontSize="11" Foreground="{StaticResource Muted}" Margin="0,12,0,0"><Hyperlink NavigateUri="https://github.com/TranslucentTB/TranslucentTB" RequestNavigate="OnNavigate" Foreground="{StaticResource Muted}" TextDecorations="None">TranslucentTB</Hyperlink></TextBlock>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
 </Grid>
</Window>
