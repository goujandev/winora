<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>Winora.Program</StartupObject>
    <AssemblyName>Winora</AssemblyName>
    <Version>0.1.0</Version>
    <Product>Winora</Product>
    <Description>Personalise your Windows desktop.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
    <Content Include="release.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
